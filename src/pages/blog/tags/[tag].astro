---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0)),
    },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
}

const { tag, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title={`Articles tagged “${tag}” — Abrar Zamil`}
  description={`Articles by Abrar Zamil tagged ${tag}: Python, workflow automation, AI integrations and data dashboards.`}
>
  <h1>Tagged &ldquo;{tag}&rdquo;</h1>
  <p class="muted">{posts.length} article{posts.length === 1 ? '' : 's'}</p>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <h2><a href={`${base}blog/${post.slug}/`}>{post.data.title}</a></h2>
        <p class="muted small">
          {post.data.pubDate && <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>}
        </p>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
  <p><a href={`${base}`}>← All articles</a></p>
</BaseLayout>
