---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0)),
    },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
}

const { tag, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={`Articles tagged “${tag}” — Abrar Zamil`}
  description={`Articles by Abrar Zamil tagged ${tag}: Python, workflow automation, AI integrations and data dashboards.`}
>
  <div class="bento">
    <section class="hero span-6 rise" aria-labelledby="tag-heading">
      <span class="eyebrow">Topic</span>
      <h1 id="tag-heading">{tag}</h1>
      <p class="lead">{posts.length} article{posts.length === 1 ? '' : 's'} on this topic.</p>
    </section>
    {posts.map((post, i) => (
      <PostCard post={post} span={3} level="h2" num={String(i + 1).padStart(2, '0')} delay={`${0.1 + i * 0.1}s`} />
    ))}
    <p class="span-6 rise" style="--d: 0.3s"><a href={`${base}`}>← All articles</a></p>
  </div>
</BaseLayout>
