---
import BaseLayout from './BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  readingMinutes: number;
  related: CollectionEntry<'blog'>[];
}

const { post, readingMinutes, related } = Astro.props;
const { title, description, pubDate, updatedDate, tags, cover, portfolioLink } = post.data;
const base = import.meta.env.BASE_URL;
const canonical = Astro.url.href;
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const articleLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  ...(pubDate ? { datePublished: pubDate.toISOString() } : {}),
  dateModified: (updatedDate ?? pubDate)?.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Abrar Zamil',
    url: 'https://abrarshuvo.github.io/',
    sameAs: [
      'https://github.com/AbrarShuvo',
      'https://www.linkedin.com/in/abrar-zamil-shuvo-059b04229',
    ],
  },
  mainEntityOfPage: canonical,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL(base, Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: new URL(base, Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};
---

<BaseLayout title={title} description={description} image={cover} type="article" jsonLd={[articleLd, breadcrumbLd]}>
  <div class="narrow">
    <nav class="crumbs rise" aria-label="Breadcrumb">
      <a href={`${base}`}>Home</a> / <a href={`${base}`}>Articles</a> / {title}
    </nav>
    <header class="glass article-hero rise" style="--d: 0.05s">
      <span class="eyebrow">{tags[0] ?? 'Article'}</span>
      <h1>{title}</h1>
      <p class="muted small">
        {pubDate && <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>}
        {pubDate && updatedDate && updatedDate.getTime() !== pubDate.getTime() && (
          <> · Updated <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></>
        )}
        {pubDate && <> · </>}
        {readingMinutes} min read
      </p>
      {tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {tags.map((tag) => (
            <li><a href={`${base}blog/tags/${tag}/`}>{tag}</a></li>
          ))}
        </ul>
      )}
    </header>
  </div>
  <div class="prose narrow rise" style="--d: 0.15s">
    <slot />
  </div>
  {related.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">Related articles</h2>
      <div class="bento">
        {related.map((rel, i) => (
          <PostCard post={rel} span={3} delay={`${0.2 + i * 0.1}s`} />
        ))}
      </div>
    </section>
  )}
  <aside class="glass cta-box narrow rise" style="--d: 0.3s" aria-label="Work with Abrar">
    <p>
      <strong>Need something like this?</strong>
      {portfolioLink ? (
        <> See <a href={portfolioLink}>the case study</a> or <a href="https://abrarshuvo.github.io/contact.html">get in touch</a>.</>
      ) : (
        <> See <a href="https://abrarshuvo.github.io/projects.html">my work</a> or <a href="https://abrarshuvo.github.io/contact.html">get in touch</a>.</>
      )}
    </p>
  </aside>
</BaseLayout>
